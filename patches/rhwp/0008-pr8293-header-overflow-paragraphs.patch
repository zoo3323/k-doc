머리말·꼬리말 배치가 틀 아래 끝에서 멈춰, 틀을 넘친 문단을 버렸다. 한컴은 그 문단을
본문을 밀지 않고 본문 위에 겹쳐 그린다. 남은 문단도 계속 배치한다.

(cherry picked from commit 4447d39d2fa09155b1162203f4d1ed9f4e6fd1e6)
---
 src/renderer/layout/header_footer_layout.rs   |   4 +--
 .../header_overflow_paragraphs_render.rs      |  31 ++++++++++++++++++
 .../header_overflow/header-overflow.hwp       | Bin 0 -> 13312 bytes
 .../header_overflow/header-overflow.hwpx      | Bin 0 -> 7515 bytes
 4 files changed, 32 insertions(+), 3 deletions(-)
 create mode 100644 tests/cases/header_overflow_paragraphs_render.rs
 create mode 100644 tests/fixtures/header_overflow/header-overflow.hwp
 create mode 100644 tests/fixtures/header_overflow/header-overflow.hwpx

diff --git a/src/renderer/layout/header_footer_layout.rs b/src/renderer/layout/header_footer_layout.rs
index e69f9cc33..c6aa3d210 100644
--- a/src/renderer/layout/header_footer_layout.rs
+++ b/src/renderer/layout/header_footer_layout.rs
@@ -432,9 +432,7 @@ impl LayoutEngine {
                     }
                 }
             }
-            if y_offset >= area.y + area.height {
-                break;
-            }
+            // 한컴은 머리말·꼬리말 틀을 넘친 문단도 본문 위에 겹쳐 그린다. 넘친 문단을 버리지 않는다.
         }
         let local_composed: Vec<_> = hf_paragraphs
             .iter()
diff --git a/tests/cases/header_overflow_paragraphs_render.rs b/tests/cases/header_overflow_paragraphs_render.rs
new file mode 100644
index 000000000..f6cc6095c
--- /dev/null
+++ b/tests/cases/header_overflow_paragraphs_render.rs
@@ -0,0 +1,31 @@
+//! 머리말 틀을 넘친 문단도 한컴처럼 본문 위에 겹쳐 그린다.
+//! 한컴 2024 확인: 70자 두 줄·빈 문단 뒤의 "마지막"이 본문 첫 줄과 겹쳐 보이고 본문은 밀리지 않는다.
+#![cfg(not(target_arch = "wasm32"))]
+
+use rhwp::document_core::DocumentCore;
+
+fn run_y(core: &DocumentCore, text: &str) -> Option<f64> {
+    let layout: serde_json::Value =
+        serde_json::from_str(&core.get_page_text_layout_native(0).unwrap()).unwrap();
+    layout["runs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|run| run["text"] == text)
+        .and_then(|run| run["y"].as_f64())
+}
+
+#[test]
+fn header_paragraph_past_the_header_area_is_drawn_over_the_body() {
+    for bytes in [
+        &include_bytes!("../fixtures/header_overflow/header-overflow.hwp")[..],
+        &include_bytes!("../fixtures/header_overflow/header-overflow.hwpx")[..],
+    ] {
+        let core = DocumentCore::from_bytes(bytes).unwrap();
+        let body = run_y(&core, "본문").expect("본문 첫 줄");
+        let overflow = run_y(&core, "마지막").expect("넘친 머리말 문단도 그린다");
+        // 본문을 밀지 않고 그 위에 겹친다.
+        assert!(overflow >= body - 1.0, "{overflow} < {body}");
+        assert!(core.render_page_svg_native(0).unwrap().contains(">마<"));
+    }
+}
