+                tac_flow_top = moved_line_top;
+                y_offset = moved_line_top.map_or(placed_y, |top| top + outer_top);
                 tac_table_y_before = y_offset;
             }
             let raw_mt = measured_tables
@@ -14001,6 +14101,17 @@ impl LayoutEngine {
