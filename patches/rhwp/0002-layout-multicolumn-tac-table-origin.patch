--- a/src/renderer/height_cursor.rs
+++ b/src/renderer/height_cursor.rs
@@ -2851,6 +2851,27 @@ impl HeightCursor {
         Some(col_y + hwpunit_to_px(first_vpos - base, self.dpi))
     }
 
+    /// 저장 첫 줄이 실제로 `line_y` 에 놓인 문단으로 활성 저장 기준점을 다시 잇는다.
+    /// 기준점이 없으면(저장 스냅을 쓰지 않는 흐름) 새로 켜지 않는다.
+    pub(crate) fn rebase_active_vpos_to_line(&mut self, para: &Paragraph, line_y: f64) {
+        let Some(first) = para.line_segs.first() else {
+            return;
+        };
+        let (anchor, page_base) = if self.vpos_page_base.is_some() {
+            (self.col_anchor_y, true)
+        } else if self.vpos_lazy_base.is_some() {
+            (self.col_area_y, false)
+        } else {
+            return;
+        };
+        let base = first.vertical_pos - crate::renderer::px_to_hwpunit(line_y - anchor, self.dpi);
+        if page_base {
+            self.vpos_page_base = Some(base);
+        } else {
+            self.vpos_lazy_base = Some(base);
+        }
+    }
+
     /// 이미 계산된 vpos 기준 y보다 실제 렌더 y를 아래로 밀었을 때, 후속 항목도
     /// 같은 시각 기준을 따르도록 활성 vpos base를 반대로 이동한다.
     pub(crate) fn shift_vpos_base_for_rendered_delta(&mut self, delta_px: f64) {
