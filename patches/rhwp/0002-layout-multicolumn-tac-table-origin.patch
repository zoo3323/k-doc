             .any(|ctrl| matches!(ctrl, Control::Table(t) if is_para_topbottom_float(&t.common)))
 }
 
+/// 이 단에 마지막으로 그린 본문 글줄에서 저장 vpos 차이만큼 내려간 줄 시작 y.
+/// 마지막 글줄이 앞 문단에 속하고 그 vpos 가 이 줄보다 작을 때만(같은 저장 사다리) 쓴다.
+fn stored_line_top_after_painted(
+    col_node: &RenderNode,
+    para_index: usize,
+    vpos: i32,
+    dpi: f64,
+) -> Option<f64> {
+    let (last_para, last_vpos, last_top) = col_node
+        .children
+        .iter()
+        .filter_map(|node| match &node.node_type {
+            RenderNodeType::TextLine(line) => line
+                .para_index
+                .map(|pi| ((pi, line.line_index.unwrap_or(0)), line.vpos, node.bbox.y)),
+            _ => None,
+        })
+        .max_by_key(|(order, _, _)| *order)
+        .map(|((pi, _), vpos, top)| (pi, vpos, top))?;
+    let last_vpos = last_vpos?;
+    (last_para < para_index && last_vpos < vpos)
+        .then(|| last_top + hwpunit_to_px(vpos - last_vpos, dpi))
+}
+
+/// 한 줄 문단의 저장 전진폭(px): 다음 문단 첫 줄 vpos − 이 문단 줄 vpos.
+/// 다음 문단이 다른 단·쪽에서 사다리를 다시 시작하거나 값이 줄 높이보다 작으면 쓰지 않는다.
+fn stored_single_line_advance_px(
+    para: &Paragraph,
+    next: Option<&Paragraph>,
+    dpi: f64,
+) -> Option<f64> {
+    let [line] = para.line_segs.as_slice() else {
+        return None;
+    };
+    let next_line = next?.line_segs.first()?;
+    let delta = next_line.vertical_pos - line.vertical_pos;
+    (delta >= line.line_height && delta > 0).then(|| hwpunit_to_px(delta, dpi))
+}
+
 /// 이 단에 이미 그려진 흐름 글자의 최하단 y — 없으면 `None`.
 ///
 /// 저장 사다리의 음수 줄간격(`line_spacing < 0`)은 줄 상자를 글자보다 좁게 만든다.
@@ -3433,6 +3472,9 @@ pub struct LayoutEngine {
     last_item_content_bottom: std::cell::Cell<f64>,
