+mod equalize_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    fn table_of(core: &DocumentCore, para: usize, ctrl: usize) -> &crate::model::table::Table {
+        match &core.document.sections[0].paragraphs[para].controls[ctrl] {
+            Control::Table(t) => t,
+            _ => panic!("not a table"),
+        }
+    }
+
+    #[test]
+    fn equalize_cell_widths_and_heights_keeps_the_table_size() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank document");
+        let created: serde_json::Value =
+            serde_json::from_str(&core.create_table_native(0, 0, 0, 2, 3).expect("table")).expect("json");
+        let para = created["paraIdx"].as_u64().unwrap() as usize;
+        let ctrl = created["controlIdx"].as_u64().unwrap() as usize;
+        let path = [(ctrl, 0, 0)];
+
+        // 첫 칸을 넓히고 둘째 칸을 줄여 칸 폭을 어긋나게 만든다.
+        core.resize_table_cells_native(0, para, ctrl, r#"[{"cellIdx":0,"widthDelta":3000},{"cellIdx":3,"widthDelta":3000},{"cellIdx":1,"widthDelta":-3000},{"cellIdx":4,"widthDelta":-3000}]"#)
+            .expect("resize");
+        let before = table_of(&core, para, ctrl).get_column_widths();
+        assert_ne!(before[0], before[1]);
+        let total_before: u32 = before.iter().sum();
+
+        core.equalize_table_cells_native(0, para, &path, 0, 0, 1, 2, true).expect("equal widths");
+        let after = table_of(&core, para, ctrl).get_column_widths();
+        assert_eq!(after.iter().sum::<u32>(), total_before, "표 폭은 그대로");
+        assert!(after.iter().max().unwrap() - after.iter().min().unwrap() <= 2, "{after:?}");
+
+        core.resize_table_cells_native(0, para, ctrl, r#"[{"cellIdx":0,"heightDelta":2000},{"cellIdx":1,"heightDelta":2000},{"cellIdx":2,"heightDelta":2000}]"#)
+            .expect("resize rows");
+        let rows_before = table_of(&core, para, ctrl).get_row_heights();
+        assert_ne!(rows_before[0], rows_before[1]);
+        core.equalize_table_cells_native(0, para, &path, 0, 0, 1, 0, false).expect("equal heights");
+        let rows_after = table_of(&core, para, ctrl).get_row_heights();
+        assert_eq!(rows_after.iter().sum::<u32>(), rows_before.iter().sum::<u32>());
+        assert!(rows_after[0].abs_diff(rows_after[1]) <= 1, "{rows_after:?}");
+    }
+}
