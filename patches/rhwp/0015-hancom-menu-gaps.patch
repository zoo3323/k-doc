+/**
+ * 한글 「입력 → 캡션 넣기」 위치 9가지. 캡션이 없으면 그 자리에 넣고 캡션 글 편집으로 들어가고,
+ * 있으면 자리만 옮긴다. 「캡션 없음」은 뗀다. 대상은 고른 그림·도형, 아니면 캐럿이 있는 표다.
+ */
+function captionPositionCommands(): CommandDef[] {
+  return CAPTION_POSITIONS.map(([id, labelKey, side, vert]) => ({
+    id,
+    label: t(labelKey),
+    canExecute: (ctx) => ctx.inPictureObjectSelection || ctx.inTable || ctx.inTableObjectSelection,
+    execute(services) {
+      const ih = services.getInputHandler();
+      if (!ih) return;
+      if (ih.isInPictureObjectSelection()) {
+        applyObjectCaption(services, ih, side, vert);
+        return;
+      }
+      applyTableCaption(services, ih, side, vert);
+    },
+  }));
+}
+
+function applyObjectCaption(
+  services: import('../types').CommandServices,
+  ih: InputHandler,
+  side: CaptionSide | null,
+  vert: CaptionVert | null,
+): void {
+  const ref = ih.getSelectedPictureRef();
+  if (!ref) return;
+  if (ref.type === 'equation' || ref.type === 'group') {
+    showToast({ message: '이 개체에는 아직 캡션을 넣을 수 없어요.' });
+    return;
+  }
+  let props: Record<string, unknown>;
+  try { props = getProps(services, ref); } catch { return; }
+  const had = Boolean(props.hasCaption);
+  if (!side || !vert) {
+    if (!had) return;
+    recordObjectMutation(ih, 'captionRemove', (wasm) => { setObjectProps(wasm, ref, { hasCaption: false }); });
+    return;
+  }
+  let created: any = null;
+  recordObjectMutation(ih, had ? 'captionMove' : 'captionInsert', (wasm) => {
+    created = setObjectProps(wasm, ref, {
+      hasCaption: true,
+      captionDirection: side,
+      captionVertAlign: vert,
+      ...(had ? {} : { captionWidth: CAPTION_SIDE_WIDTH, captionSpacing: CAPTION_SPACING, captionIncludeMargin: false }),
+    });
+  }, had ? undefined : DEFER_REFRESH_TO_EXIT);
+  if (had) return;
+  ih.exitPictureObjectSelectionAndAfterEdit();
+  ih.enterInlineEditing(ref.sec, ref.ppi, ref.ci, created?.captionCharOffset ?? 4);
+}
+
+function applyTableCaption(
+  services: import('../types').CommandServices,
+  ih: InputHandler,
+  side: CaptionSide | null,
+  vert: CaptionVert | null,
+): void {
+  const tableRef = ih.isInTableObjectSelection() ? ih.getSelectedTableRef() : null;
+  let sec: number, ppi: number, ci: number;
+  if (tableRef) {
+    sec = tableRef.sec; ppi = tableRef.ppi; ci = tableRef.ci;
+  } else {
+    const pos = ih.getCursorPosition();
+    if (pos.parentParaIndex === undefined || pos.controlIndex === undefined) return;
+    if ((pos.cellPath?.length ?? 0) > 1) {
+      showToast({ message: '표 안의 표에는 아직 캡션을 넣을 수 없어요.' });
+      return;
+    }
+    sec = pos.sectionIndex; ppi = pos.parentParaIndex; ci = pos.controlIndex;
+  }
+  let props: any;
+  try { props = services.wasm.getTableProperties(sec, ppi, ci); } catch { return; }
+  if (!props) return;
+  const had = Boolean(props.hasCaption);
+  if (!side || !vert) {
+    if (!had) return;
+    ih.executeOperation({
+      kind: 'snapshot',
+      operationType: 'tableCaptionRemove',
+      operation: (wasm) => {
+        wasm.setTableProperties(sec, ppi, ci, { hasCaption: false });
+        return { sectionIndex: sec, paragraphIndex: ppi, charOffset: 0 };
+      },
+    });
+    return;
+  }
+  let charOffset = 3;
+  ih.executeOperation({
+    kind: 'snapshot',
+    operationType: had ? 'tableCaptionMove' : 'tableCaptionInsert',
+    operation: (wasm) => {
+      const result: any = wasm.setTableProperties(sec, ppi, ci, {
+        hasCaption: true,
+        captionDirection: TABLE_CAPTION_SIDE[side],
+        captionVertAlign: TABLE_CAPTION_VERT[vert],
+        ...(had || (side !== 'Left' && side !== 'Right') ? {} : { captionWidth: CAPTION_SIDE_WIDTH }),
+      });
+      charOffset = result?.captionCharOffset ?? 3;
+      return { sectionIndex: sec, paragraphIndex: ppi, charOffset: 0 };
+    },
+  });
+  if (had) return;
+  if (tableRef) ih.exitTableObjectSelection();
+  ih.enterTableCaptionEditing(sec, ppi, ci, charOffset);
+}
