+// 표 속성은 방향·세로 정렬을 숫자로 받는다(table_ops.rs: Left 0·Right 1·Top 2·Bottom 3 / Top 0·Center 1·Bottom 2).
+const TABLE_CAPTION_SIDE: Record<CaptionSide, number> = { Left: 0, Right: 1, Top: 2, Bottom: 3 };
+const TABLE_CAPTION_VERT: Record<CaptionVert, number> = { Top: 0, Center: 1, Bottom: 2 };
+const CAPTION_SIDE_WIDTH = Math.round(30 * 283.46);
