+
+/**
+ * 한글 「셀 높이를 같게(H)」·「셀 너비를 같게(W)」: F5 블록의 줄(칸)들을 합은 그대로 두고 고르게 나눈다.
+ * 칸 경계는 표 전체 격자라서 블록이 걸친 칸 전체가 같이 바뀐다. 중첩 표도 셀 경로로 바로 고친다.
+ */
+function equalizeSelectedCells(services: CommandServices, axis: 'width' | 'height'): void {
+  const ih = services.getInputHandler();
+  if (!ih || !ih.isInCellSelectionMode()) return;
+  const tableContext = ih.getCellTableContext();
+  const range = ih.getSelectedCellRange();
+  if (!tableContext || !range) return;
+  const pos = ih.getCursorPosition();
+  const cellPath = tableContext.cellPath?.length
+    ? tableContext.cellPath
+    : [{ controlIndex: tableContext.ci, cellIndex: pos.cellIndex ?? 0, cellParaIndex: 0 }];
+  safeTableOp(() => ih.executeOperation({
+    kind: 'snapshot',
+    operationType: axis === 'width' ? 'tableCellWidthEqual' : 'tableCellHeightEqual',
+    operation: (wasm) => {
+      const result = JSON.parse(wasm.equalizeTableCells(
+        tableContext.sec, tableContext.ppi, JSON.stringify(cellPath),
+        range.startRow, range.startCol, range.endRow, range.endCol, axis,
+      ));
+      return result.changed === false ? null : pos;
+    },
+  }), axis === 'width' ? '셀 너비를 같게' : '셀 높이를 같게');
+}
