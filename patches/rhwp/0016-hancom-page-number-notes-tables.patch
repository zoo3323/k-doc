+        let mut footnote_number = section.section_def.footnote_shape.start_number.max(1);
         let mut endnote_number = section.section_def.endnote_shape.start_number.max(1);
         for para in &mut section.paragraphs {
             for ctrl in &mut para.controls {
@@ -892,3 +964,32 @@ mod delete_footnote_char_shape_tests {
