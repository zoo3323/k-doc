+
+    #[test]
+    fn char_overlap_is_inserted_at_the_caret_and_survives_save() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank");
+        core.insert_text_native(0, 0, 0, "가나").expect("text");
+        let r = core.insert_char_overlap_native(0, 0, 1, "12", 1, -2).expect("overlap");
+        assert!(r.contains("\"ok\":true"), "{r}");
+        let para = &core.document.sections[0].paragraphs[0];
+        let overlap = para.controls.iter().find_map(|c| match c {
+            Control::CharOverlap(o) => Some(o.clone()),
+            _ => None,
+        });
+        let overlap = overlap.expect("글자 겹치기 컨트롤");
+        assert_eq!(overlap.chars, vec!['1', '2']);
+        assert_eq!(overlap.border_type, 1);
+        assert_eq!(para.text, "가나", "본문 글자는 그대로");
+
+        let saved = core.export_hwp_native().expect("save");
+        let reopened = DocumentCore::from_bytes(&saved).expect("reopen");
+        let again = reopened.document.sections[0].paragraphs[0]
+            .controls
+            .iter()
+            .any(|c| matches!(c, Control::CharOverlap(o) if o.chars == vec!['1', '2']));
+        assert!(again, "저장 뒤에도 남는다");
+    }
