diff --git a/src/document_core/commands/footnote_ops.rs b/src/document_core/commands/footnote_ops.rs
index 57337fb17..e589ee597 100644
--- a/src/document_core/commands/footnote_ops.rs
+++ b/src/document_core/commands/footnote_ops.rs
@@ -13,11 +13,83 @@ use crate::model::paragraph::{ParaMeta, Paragraph};
 use crate::renderer::composer::{reflow_line_segs, restamp_indentation, ParagraphBox};
 
 impl DocumentCore {
+    /// 한글 「입력 → 주석 → 각주/미주 변환」: 문서의 각주를 모두 미주로(`to_endnote`), 또는
+    /// 미주를 모두 각주로 바꾼다. 내용·장식은 그대로 옮기고 번호는 구역마다 다시 매긴다.
+    /// 반환 `{"ok":true,"converted":N}`.
+    pub fn convert_notes_native(&mut self, to_endnote: bool) -> Result<String, crate::error::HwpError> {
+        fn walk(paragraphs: &mut [Paragraph], to_endnote: bool, count: &mut usize) {
+            for para in paragraphs.iter_mut() {
+                for ctrl in para.controls.iter_mut() {
+                    match ctrl {
+                        Control::Footnote(f) if to_endnote => {
+                            let f = std::mem::take(&mut **f);
+                            *ctrl = Control::Endnote(Box::new(crate::model::footnote::Endnote {
+                                number: f.number,
+                                paragraphs: f.paragraphs,
+                                before_decoration_letter: f.before_decoration_letter,
+                                after_decoration_letter: f.after_decoration_letter,
+                                number_shape: f.number_shape,
+                                instance_id: f.instance_id,
+                                list_header_property: f.list_header_property,
+                                decoration_is_user_char: f.decoration_is_user_char,
+                            }));
+                            *count += 1;
+                        }
+                        Control::Endnote(e) if !to_endnote => {
+                            let e = std::mem::take(&mut **e);
+                            *ctrl = Control::Footnote(Box::new(crate::model::footnote::Footnote {
+                                number: e.number,
+                                paragraphs: e.paragraphs,
+                                before_decoration_letter: e.before_decoration_letter,
+                                after_decoration_letter: e.after_decoration_letter,
+                                number_shape: e.number_shape,
+                                instance_id: e.instance_id,
+                                list_header_property: e.list_header_property,
+                                decoration_is_user_char: e.decoration_is_user_char,
+                            }));
+                            *count += 1;
+                        }
+                        Control::Table(table) => {
+                            for cell in table.cells.iter_mut() {
+                                walk(&mut cell.paragraphs, to_endnote, count);
+                            }
+                        }
+                        Control::Shape(shape) => {
+                            if let Some(tb) = shape.drawing_mut().and_then(|d| d.text_box.as_mut()) {
+                                walk(&mut tb.paragraphs, to_endnote, count);
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+
+        let mut total = 0usize;
+        for section_idx in 0..self.document.sections.len() {
+            let mut count = 0usize;
+            walk(&mut self.document.sections[section_idx].paragraphs, to_endnote, &mut count);
+            if count > 0 {
+                self.document.sections[section_idx].raw_stream = None;
+                self.renumber_footnotes_in_section(section_idx);
+                self.mark_section_dirty(section_idx);
+                self.recompose_section(section_idx);
+                total += count;
+            }
+        }
+        if total > 0 {
+            self.paginate_if_needed();
+            self.invalidate_page_tree_cache();
+        }
+        Ok(format!("{{\"ok\":true,\"converted\":{}}}", total))
+    }
+
