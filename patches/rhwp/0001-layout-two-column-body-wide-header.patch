 }
+
+/// 다단 쪽에서 본문 폭 전체에 걸치는 자리차지 개체가 단 시작을 미는 높이.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) struct BodyWideReserve {
+    /// 개체가 앵커된 문단.
+    pub para_index: usize,
+    /// 바깥 아래 여백까지 포함한 개체 하단 y(px).
