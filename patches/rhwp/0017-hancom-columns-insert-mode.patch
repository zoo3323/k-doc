+    /// 한글 「단 → 왼쪽/오른쪽」처럼 단마다 너비가 다른 다단. `ratios` 는 단 너비 비율
+    /// (예: 왼쪽 `[1, 2]`, 오른쪽 `[2, 1]`), `spacing_hu` 는 단 사이 간격이다. 한컴처럼
+    /// 비례값(합 32768)으로 저장한다.
+    pub fn set_column_ratios_native(
+        &mut self,
+        section_idx: usize,
+        ratios: &[u16],
+        spacing_hu: i16,
+    ) -> Result<String, HwpError> {
+        use crate::model::page::ColumnDef;
+        if ratios.len() < 2 || ratios.len() > 255 || ratios.iter().any(|&r| r == 0) {
+            return Err(HwpError::RenderError("단 너비 비율은 둘 이상, 0 이 아니어야 합니다".into()));
+        }
+        let count = ratios.len() as u16;
+        self.set_column_def_native(section_idx, count, 0, false, spacing_hu)?;
+        let pd = &self.document.sections[section_idx].section_def.page_def;
+        let body = (pd.width as i64 - pd.margin_left as i64 - pd.margin_right as i64 - pd.margin_gutter as i64).max(1) as f64;
+        const TOTAL: f64 = 32768.0;
+        let gap = ((spacing_hu.max(0) as f64 / body) * TOTAL).round();
+        let usable = (TOTAL - gap * (ratios.len() - 1) as f64).max(ratios.len() as f64);
+        let sum: f64 = ratios.iter().map(|&r| r as f64).sum();
+        let mut widths: Vec<i16> = ratios.iter().map(|&r| (usable * r as f64 / sum).floor() as u16 as i16).collect();
+        // 반올림 나머지는 마지막 단에 얹어 합을 32768 로 맞춘다.
+        let used: i64 = widths.iter().map(|&w| w as u16 as i64).sum::<i64>() + gap as i64 * (ratios.len() as i64 - 1);
+        if let Some(last) = widths.last_mut() {
+            *last = ((*last as u16 as i64) + (TOTAL as i64 - used)) as u16 as i16;
+        }
+        let gaps: Vec<i16> = (0..ratios.len()).map(|i| if i + 1 < ratios.len() { gap as u16 as i16 } else { 0 }).collect();
+        for para in self.document.sections[section_idx].paragraphs.iter_mut() {
+            if let Some(Control::ColumnDef(cd)) = para.controls.iter_mut().find(|c| matches!(c, Control::ColumnDef(_))) {
+                let cd: &mut ColumnDef = cd;
+                cd.same_width = false;
+                cd.proportional_widths = true;
+                cd.widths = widths.clone();
+                cd.gaps = gaps.clone();
+                cd.raw_attr = 0;
+                break;
+            }
+        }
+        self.reflow_body_paragraphs_in_section(section_idx);
+        self.document.sections[section_idx].raw_stream = None;
+        self.rebuild_section(section_idx);
+        Ok(crate::document_core::helpers::json_ok())
+    }
+
     /// 다단 설정 변경
     ///
     /// 구역의 초기 ColumnDef 컨트롤을 찾아 수정한다.
@@ -7937,3 +7982,33 @@ mod tests {
         );
