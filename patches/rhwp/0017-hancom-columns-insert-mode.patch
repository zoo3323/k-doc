 }
+
+#[cfg(test)]
+mod column_ratio_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    #[test]
+    fn left_preset_makes_a_narrow_left_column() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank");
+        core.set_column_ratios_native(0, &[1, 2], 2268).expect("ratios");
+        let cd = core.document.sections[0]
+            .paragraphs
+            .iter()
+            .flat_map(|p| p.controls.iter())
+            .find_map(|c| match c {
+                Control::ColumnDef(cd) => Some(cd.clone()),
+                _ => None,
+            })
+            .expect("단 정의");
+        assert_eq!(cd.column_count, 2);
+        assert!(!cd.same_width && cd.proportional_widths);
+        let w: Vec<u16> = cd.widths.iter().map(|&w| w as u16).collect();
+        assert!(w[0] * 2 <= w[1] + 2, "왼쪽 단이 좁다: {w:?}");
+        let total: u32 = w.iter().map(|&v| v as u32).sum::<u32>() + cd.gaps.iter().map(|&g| g as u16 as u32).sum::<u32>();
+        assert_eq!(total, 32768);
+        let saved = core.export_hwp_native().expect("save");
+        DocumentCore::from_bytes(&saved).expect("reopen");
+    }
+}
