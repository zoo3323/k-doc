 import { t } from '../../i18n/index.ts';
 import { clampedCellAfterDelete } from '@/engine/table-cell-clamp';
+import { showToast } from '@/ui/toast';
+
+/**
+ * 중첩 표(cellPath 깊이 2+)의 구조 편집은 엔진에 경로 API 가 없어 flat 좌표가 바깥 표를
+ * 가리킨다. 그대로 실행하면 바깥 표에 줄이 생기거나 바깥 표가 지워진다(#8138). 경로 API 가
+ * 생기기 전까지는 막고 알린다. `table:split`·`table:attach` 와 같은 기준이다.
+ */
+function blockNestedTableStructureEdit(cellPath: readonly unknown[] | undefined): boolean {
+  if ((cellPath?.length ?? 0) <= 1) return false;
+  showToast({ message: '표 안의 표에서는 줄·칸 추가/삭제, 셀 합치기·나누기, 표 지우기를 아직 할 수 없습니다.' });
+  return true;
+}
 const inTable = (ctx: EditorContext) => ctx.inTable;
 const inTableOrCellSelection = (ctx: EditorContext) => ctx.inTable || ctx.inCellSelectionMode;
 const hasMultiCellSelection = (ctx: EditorContext) => ctx.hasMultiCellSelection;
