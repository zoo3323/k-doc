diff --git a/src/document_core/commands/object_ops/picture.rs b/src/document_core/commands/object_ops/picture.rs
index e716dbd7d..48c2e8d77 100644
--- a/src/document_core/commands/object_ops/picture.rs
+++ b/src/document_core/commands/object_ops/picture.rs
@@ -1440,6 +1440,162 @@ impl DocumentCore {
         Ok(format!("{{\"ok\":true,\"binDataId\":{}}}", position_id))
     }
 
+    /// 표 셀 문단 안에 그림을 넣는다 — 한글 기본(「마우스로 크기 지정」 끔)과 같다.
+    ///
+    /// 셀 문단에 앵커한 자리차지(위아래) 그림이라 셀·표와 함께 움직인다(한컴 표본
+    /// `ta-pic-cell-*.hwpx`: vertRelTo=PARA, horzRelTo=COLUMN, TOP_AND_BOTTOM). 셀 안쪽 폭보다
+    /// 넓으면 비율을 지켜 줄인다. 드래그로 그린 자리에 종이 기준으로 띄우는
+    /// `insert_picture_native` 의 셀 분기와 다르다.
+    ///
+    /// 반환: `{"ok":true,"paraIdx":<바깥 문단>,"controlIdx":<셀 문단 안 컨트롤>,"width":W,"height":H}`
+    #[allow(clippy::too_many_arguments)]
+    pub fn insert_picture_in_cell_paragraph_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        cell_path: &[(usize, usize, usize)],
+        char_offset: usize,
+        image_data: &[u8],
+        width: u32,
+        height: u32,
+        natural_width_px: u32,
+        natural_height_px: u32,
+        extension: &str,
+        description: &str,
+    ) -> Result<String, HwpError> {
+        use crate::model::image::{CropInfo, ImageAttr, ImageEffect, Picture};
+        use crate::model::shape::{
+            CommonObjAttr, HorzRelTo, ShapeComponentAttr, TextWrap, VertRelTo,
+        };
+
+        if cell_path.is_empty() {
+            return Err(HwpError::RenderError("셀 경로가 비어 있습니다".to_string()));
+        }
+        if section_idx >= self.document.sections.len() {
+            return Err(HwpError::RenderError(format!(
+                "구역 인덱스 {} 범위 초과",
+                section_idx
+            )));
+        }
+        if image_data.is_empty() {
+            return Err(HwpError::RenderError(
+                "이미지 데이터가 비어 있습니다".to_string(),
+            ));
+        }
+        if Self::cell_path_terminates_at_textbox(
+            &self.document.sections[section_idx],
+            parent_para_idx,
+            cell_path,
+        )? {
+            return Err(HwpError::RenderError(
+                "글상자 안 그림은 insert_picture_native 를 쓴다".to_string(),
+            ));
+        }
+        self.resolve_cell_by_path(section_idx, parent_para_idx, cell_path)?;
+
+        // 셀 안쪽 폭에 맞춘다(비율 유지).
+        let (mut width, mut height) = (width.max(1), height.max(1));
+        if let Some((cell_width, pad_left, pad_right)) =
+            self.resolve_innermost_cell_metrics(section_idx, parent_para_idx, cell_path)
+        {
+            let inner = (cell_width - pad_left as i32 - pad_right as i32).max(1) as u32;
+            if width > inner {
+                height = ((height as u64 * inner as u64) / width as u64).max(1) as u32;
+                width = inner;
+            }
+        }
+
+        let position_id = self.register_embedded_bin_data(image_data, extension);
+        let shape_attr = ShapeComponentAttr {
+            original_width: width,
+            original_height: height,
+            current_width: width,
+            current_height: height,
+            local_file_version: 1,
+            render_sx: 1.0,
+            render_sy: 1.0,
+            ..Default::default()
+        };
+        let mut common = CommonObjAttr {
