@@ -474,6 +474,17 @@ pub(in crate::renderer::typeset) fn place_with_storage<S: crate::storage::Storag
                     engine.dpi,
                     storage,
                 )?;
+                // 글자 없는 host 의 자리차지 도형도 뒤 형제 부동 표가 피할 lane 에 둔다.
+                if !super::super::para_has_visible_text(para) {
+                    st.register_empty_host_object_lane(
+                        para_idx,
+                        ctrl_idx,
+                        para,
+                        para_start_height,
+                        host_margins(para, composed, styles),
+                        &mut para_float_lanes,
+                    );
+                }
             }
             _ => {}
         }
@@ -530,3 +541,24 @@ pub(in crate::renderer::typeset) fn place_with_storage<S: crate::storage::Storag
 
     Ok(())
 }
+
+/// 문단 기준 가로 위치에 쓰는 host 좌우 여백 — 빈 host 부동 표(`empty_float`)와 같은 계산.
+fn host_margins(
+    para: &Paragraph,
+    composed: Option<&crate::renderer::composer::ComposedParagraph>,
+    styles: &crate::renderer::style_resolver::ResolvedStyleSet,
+) -> (f64, f64) {
+    let para_style_id = composed
+        .map(|c| c.para_style_id as usize)
+        .unwrap_or(para.para_shape_id as usize);
+    let para_style = styles.para_styles.get(para_style_id);
+    let margin_left = para_style.map(|s| s.margin_left).unwrap_or(0.0);
+    let indent = para_style.map(|s| s.indent).unwrap_or(0.0);
+    let effective_margin = if indent > 0.0 {
+        margin_left + indent
+    } else {
+        margin_left
+    };
+    let margin_right = para_style.map(|s| s.margin_right).unwrap_or(0.0);
+    (effective_margin, margin_right)
+}
diff --git a/src/renderer/typeset/state.rs b/src/renderer/typeset/state.rs
index c90a87112..3d7df34aa 100644
--- a/src/renderer/typeset/state.rs
+++ b/src/renderer/typeset/state.rs
@@ -566,6 +566,120 @@ impl TypesetState {
         Ok(())
     }
 
+    /// 글자 없는 표 host 의 비-TAC 자리차지 도형·그림을 같은 문단의 부동 표 lane 에 넣는다.
+    ///
+    /// 한/글은 같은 문단에 앵커된 자리차지 개체를 컨트롤 순서대로 쌓는다. 표는 lane 으로
+    /// 서로를 피하지만 도형은 흐름 커서로만 전진해서, 도형 뒤에 오는 형제 표가 도형을
+    /// 모른 채 앞 표 바로 아래에 앉아 도형과 겹쳤다.
+    /// - 문단 기준 도형: 조판이 수용한 프레임(위 여백 + 높이 + 아래 여백)을 lane 으로 둔다.
+    /// - 쪽·종이 기준 도형: 바깥 여백 포함 밴드가 문단 시작을 덮을 때만 그 밴드를 lane 으로
+    ///   둔다. 뒤 형제의 문단 기준 원점이 밴드 아래가 된다(한/글 저장 vpos 와 같은 합).
+    pub(super) fn register_empty_host_object_lane(
+        &self,
+        para_idx: usize,
+        ctrl_idx: usize,
+        para: &Paragraph,
+        para_start_height: f64,
+        host_margins: (f64, f64),
+        lanes: &mut FloatLaneSet,
+    ) {
+        use crate::model::shape::{TextWrap, VertRelTo};
+        use crate::renderer::float_placement::{
+            horizontal_range, signed_hwpunit, topbottom_shape_top_margin_hu, FloatPlacementContext,
+            ObjectPlacementFrame, ParagraphFloatFlow,
+        };
+        use crate::renderer::hwpunit_to_px;
+
+        let Some(control) = para.controls.get(ctrl_idx) else {
+            return;
+        };
+        let common = match control {
+            Control::Shape(shape) => shape.common(),
+            Control::Picture(picture) => &picture.common,
+            _ => return,
+        };
+        if common.treat_as_char
+            || common.text_wrap != TextWrap::TopAndBottom
+            || common.allow_overlap
+        {
+            return;
+        }
+        // 다음 단으로 이월된 개체는 이 단의 형제를 밀지 않는다.
+        if !self.data.current_items.iter().any(|item| {
+            matches!(item, PageItem::Shape { para_index, control_index }
+                if *para_index == para_idx && *control_index == ctrl_idx)
+        }) {
+            return;
+        }
+        let dpi = self.data.layout.dpi;
+        let width_px = hwpunit_to_px(signed_hwpunit(common.width), dpi);
+        if width_px <= 0.0 {
+            return;
+        }
+        let column = self
+            .data
+            .layout
+            .column_areas
+            .get(self.data.current_column as usize)
+            .copied()
+            .unwrap_or(self.data.layout.body_area);
+        let placement_ctx = FloatPlacementContext::new(column)
+            .with_body_area(self.data.layout.body_area)
+            .with_paper_width(self.data.layout.page_width)
+            .with_host_margins(host_margins.0, host_margins.1);
+        let (x_start, x_end) = horizontal_range(common, width_px, placement_ctx, dpi);
+        match common.vert_rel_to {
+            VertRelTo::Para => {
+                let Some(frame) = self
+                    .data
+                    .paragraph_float_placements
+                    .get(&(para_idx, ctrl_idx))
+                    .filter(|frame| frame.flow == ParagraphFloatFlow::NextLine)
+                else {
+                    return;
+                };
+                // 수용 프레임의 점유 끝은 아래 여백까지다. 출력은 위 여백만큼 내려가므로
+                // 형제가 피할 상자에 위 여백을 더한다.
+                let top_margin = hwpunit_to_px(topbottom_shape_top_margin_hu(common), dpi);
+                let height = frame.occupied_bottom + top_margin - frame.table_top;
+                lanes.place(Some(ctrl_idx), x_start, x_end, frame.table_top, height);
+            }
+            VertRelTo::Page | VertRelTo::Paper => {
+                let paper = LayoutRect {
+                    x: 0.0,
+                    y: 0.0,
+                    width: self.data.layout.page_width,
+                    height: self.data.layout.page_height,
+                };
+                let frame = ObjectPlacementFrame {
+                    container: &column,
+                    column: &column,
+                    body: &self.data.layout.body_area,
+                    paper: &paper,
+                    paragraph_y: column.y,
+                    alignment: crate::model::style::Alignment::Left,
+                    dpi,
+                };
+                let Some((top, bottom)) = frame.page_anchored_topbottom_band(control) else {
+                    return;
+                };
+                let (top, bottom) = (top - column.y, bottom - column.y);
+                // 문단 시작을 덮는 밴드만 뒤 형제의 시작점이 된다. 쪽 아래쪽 장식 등
+                // 문단 시작과 무관한 밴드는 형제를 그 아래로 끌어내리지 않는다.
+                if top > para_start_height + 0.5 || bottom <= para_start_height + 0.5 {
+                    return;
+                }
+                lanes.place(
+                    Some(ctrl_idx),
+                    x_start,
+                    x_end,
+                    para_start_height,
+                    bottom - para_start_height,
+                );
+            }
+        }
+    }
+
     /// 현재 단을 비우지 않고 다음 단의 실제 개체 상자만 예약한다.
     pub(super) fn defer_table_host_shape_to_next_column(
         &mut self,
