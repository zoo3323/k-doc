+/// 비-TAC 자리차지(위아래) 도형·그림 — 표와 같은 순서 축에서 선언 순서를 지킨다.
+fn is_ordered_topbottom_object(common: &crate::model::shape::CommonObjAttr) -> bool {
+    !common.treat_as_char
+        && matches!(
+            common.text_wrap,
+            crate::model::shape::TextWrap::TopAndBottom
+        )
+}
+
 fn is_whole_flow_table(table: &crate::model::table::Table) -> bool {
     is_para_topbottom_float(&table.common)
         && table.common.flow_with_text
@@ -216,10 +225,16 @@ pub(in crate::renderer::typeset) fn for_paragraph_with_storage<S: crate::storage
             _ => 0,
         }
     };
+    // 같은 문단의 자리차지(위아래) 도형·그림은 비-TAC 표와 같은 키를 받아 선언 순서를
+    // 지킨다. 한/글은 문단 기준 개체를 컨트롤 순서대로 위에서 아래로 쌓고, 쪽·종이 기준
+    // 개체의 밴드도 뒤 형제의 시작점이 된다. 도형을 표 뒤로 보내면 "표 → 상자 → 표"
+    // 머리 구성이 "표 → 표 → 상자"로 뒤집혀 상자가 뒤 표 아래로 밀린다.
     let table_flow_tiebreak = |ctrl: &Control| -> u8 {
         match ctrl {
             Control::Table(t) if !flow.is_effective_tac_table(para, t, fmt) => 0,
             Control::Table(t) if flow.is_effective_tac_table(para, t, fmt) => 1,
+            Control::Shape(shape) if is_ordered_topbottom_object(shape.common()) => 0,
+            Control::Picture(picture) if is_ordered_topbottom_object(&picture.common) => 0,
             _ => 1,
         }
     };
