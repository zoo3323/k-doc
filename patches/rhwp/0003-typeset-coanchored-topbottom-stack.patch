 }
 
+/// 글자처럼 취급하지 않는 자리차지 개체를 둘 이상 쌓은 빈 문단의 자기 줄 전진폭(px).
+/// 저장 사다리가 그 줄을 개체 아래에 두고(vpos > 0) 다음 문단을 정확히 그 줄 높이 +
+/// 줄간격 뒤에 둘 때만 돌려준다. 다음 문단에 글이 있으면 #6147 의 앵커 밴드 host 줄
+/// 계약(`stored_empty_anchor_band_host_line_advance_hu`)이 이미 그 줄을 계상하므로 쓰지
+/// 않는다 — 여기서는 그 계약이 다루지 않는 빈 후속 문단(해설지 머리 아래 둥근 상자 줄)만 잇는다.
+fn stacked_float_host_line_advance_px(
+    host: &Paragraph,
+    successor: &Paragraph,
+    dpi: f64,
+) -> Option<f64> {
+    if para_has_visible_text(host) || para_has_visible_text(successor) {
+        return None;
+    }
+    let [line] = host.line_segs.as_slice() else {
+        return None;
+    };
+    let mut stacked = 0;
+    for control in &host.controls {
+        let common = match control {
+            Control::Shape(shape) => shape.common(),
+            Control::Table(table) => &table.common,
+            Control::Picture(picture) => &picture.common,
+            _ => continue,
+        };
+        if common.treat_as_char || common.text_wrap != TextWrap::TopAndBottom {
+            return None;
+        }
+        stacked += 1;
+    }
+    let advance = line.line_height + line.line_spacing;
+    let next = successor.line_segs.first()?;
+    (stacked >= 2 && line.vertical_pos > 0 && next.vertical_pos - line.vertical_pos == advance)
+        .then(|| hwpunit_to_px(advance, dpi))
+}
+
 /// 이 단에 마지막으로 그린 본문 글줄에서 저장 vpos 차이만큼 내려간 줄 시작 y.
 /// 마지막 글줄이 앞 문단에 속하고 그 vpos 가 이 줄보다 작을 때만(같은 저장 사다리) 쓴다.
 fn stored_line_top_after_painted(
