+            // 전진한다(한컴 저장 사다리: 다음 문단 vpos − 빈 문단 vpos = 줄 높이 + 줄간격).
+            // 쪽 항목에는 개체만 있어 그 줄이 빠지므로 뒤 문단의 원점을 여기서 잇는다.
+            let stacked_float_host_successor_origin = (stored_table_successor_origin.is_none()
+                && !self.profile.get().session_edited()
+                && matches!(
+                    item,
+                    PageItem::FullParagraph { .. }
+                        | PageItem::PartialParagraph { start_line: 0, .. }
+                ))
+            .then(|| {
+                let owner = match item_ordinal
+                    .checked_sub(1)
+                    .and_then(|previous| col_content.items.get(previous))?
+                {
+                    PageItem::Shape { para_index, .. } | PageItem::Table { para_index, .. } => {
+                        *para_index
+                    }
+                    _ => return None,
+                };
+                (owner.checked_add(1) == Some(item_para))
+                    .then(|| {
+                        stacked_float_host_line_advance_px(
+                            paragraphs.get(owner)?,
+                            paragraphs.get(item_para)?,
+                            self.dpi,
+                        )
+                    })
+                    .flatten()
+                    .map(|advance| y_offset + advance)
+            })
+            .flatten();
             let moved_tac_successor_origin = self
                 .moved_tac_successor_line
                 .take()
@@ -8598,6 +8665,9 @@ impl LayoutEngine {
                 .map(super::height_cursor::FlowOrigin::Paragraph)
                 .or_else(|| {
                     stored_table_successor_origin.map(super::height_cursor::FlowOrigin::Line)
+                })
+                .or_else(|| {
+                    stacked_float_host_successor_origin.map(super::height_cursor::FlowOrigin::Line)
                 });
             // [#4613 · #4599 밴드-플로우] 전방 스냅 기각 판정용 — vpos_adjust 이전의 순차 흐름 위치.
             let y_before_vpos_adjust = y_offset;
