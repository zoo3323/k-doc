 //! 본문과 바탕쪽의 단 구분선에 같은 영역 계산·선 스타일을 적용한다.
 
 use super::border_rendering::border_width_to_px;
+use super::shape_layout::BodyWideReserve;
 use crate::model::header_footer::MasterPage;
 use crate::model::page::ColumnDef;
 use crate::renderer::page_layout::{calculate_column_areas, LayoutRect, PageLayoutInfo};
-use crate::renderer::render_tree::LineNode;
+use crate::renderer::render_tree::{LineNode, RenderNode, RenderNodeType};
 use crate::renderer::{hwpunit_to_px, LineStyle, StrokeDash};
 
+/// 구역 첫머리를 막는 전폭 개체 띠 아래에서 단 구분선을 시작한다.
+///
+/// 다단 쪽의 본문 폭 전체 자리차지 개체는 모든 단의 시작을 그 아래로 민다
+/// (`build_single_column` 의 `body_wide_reserved`). 한컴도 구분선을 그 띠 아래의 단
+/// 영역에만 긋는다. 2단 시험지 머리 표(문단 기준 음수 오프셋) 쪽에서 한컴 화면과 맥용
+/// 한글 12.30 Print PDF 의 구분선 위끝은 표 바깥 아래 여백 끝이다.
+/// 문단 기준 개체는 앵커 문단이 구역 첫 문단일 때만 띠로 본다. 앞에 글줄이 있으면
+/// 그 글줄 옆에도 구분선이 있어야 하기 때문이다.
+pub(super) fn start_below_header_band(
+    zone_top: f64,
+    reserves: &[BodyWideReserve],
+    zone_first_para: Option<usize>,
+) -> f64 {
+    reserves
+        .iter()
+        .filter(|reserve| !reserve.para_relative || Some(reserve.para_index) == zone_first_para)
+        .map(|reserve| reserve.bottom_y)
+        .fold(zone_top, f64::max)
+}
+
+/// 단 구분선 아래끝으로 쓸 단 내용의 물리 하단.
+///
+/// 문단 테두리·배경은 마지막 줄의 줄 뒤 간격과 테두리 간격까지 감싸므로 내용 끝이 아니다.
+/// 한컴은 구분선을 마지막 글줄 아래끝에서 멈춘다. 개체를 소유하지 않은 단 직속
+/// 사각형·선·패스·그림(문단 테두리·배경 장식)만 빼고, 글줄·표·개체는 그대로 잰다.
+pub(super) fn content_bottom(column: &RenderNode) -> Option<f64> {
+    column
+        .children
+        .iter()
+        .filter(|node| !is_paragraph_decoration(node))
+        .map(super::render_subtree_bottom)
+        .reduce(f64::max)
+}
+
+fn is_paragraph_decoration(node: &RenderNode) -> bool {
+    match &node.node_type {
+        RenderNodeType::Rectangle(shape) => shape.control_index.is_none(),
+        RenderNodeType::Line(shape) => shape.control_index.is_none(),
+        RenderNodeType::Path(shape) => shape.control_index.is_none(),
+        RenderNodeType::Image(image) => image.control_index.is_none(),
+        _ => false,
+    }
+}
+
 /// 바탕쪽의 저장 텍스트 프레임 전체를 점유하는 배경 구분선이다.
 /// 본문 내용 끝이나 본문의 단 설정으로 바탕쪽 정의를 대신하지 않는다.
 pub(super) fn master_page_lines(
diff --git a/tests/cases/two_column_exam_float_stack.rs b/tests/cases/two_column_exam_float_stack.rs
