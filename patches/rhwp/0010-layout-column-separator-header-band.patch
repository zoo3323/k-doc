--- a/tests/cases/two_column_exam_float_stack.rs
+++ b/tests/cases/two_column_exam_float_stack.rs
@@ -250,6 +250,100 @@ fn coanchored_topbottom_objects_stack_in_control_order() {
     );
 }
 
+/// 두 단 사이의 세로 단 구분선(x, 위끝, 아래끝).
+fn column_separator(root: &RenderNode) -> (f64, f64, f64) {
+    let left = column_bbox(root, 0);
+    let right = column_bbox(root, 1);
+    let mut nodes = Vec::new();
+    walk(root, &mut nodes);
+    let found: Vec<_> = nodes
+        .iter()
+        .filter_map(|n| match &n.node_type {
+            RenderNodeType::Line(line)
+                if (line.x1 - line.x2).abs() < EPS
+                    && line.x1 > left.x + left.width - EPS
+                    && line.x1 < right.x + EPS
+                    && (line.y2 - line.y1).abs() > left.height / 4.0 =>
+            {
+                Some((line.x1, line.y1.min(line.y2), line.y1.max(line.y2)))
+            }
+            _ => None,
+        })
+        .collect();
+    assert_eq!(found.len(), 1, "단 구분선 누락·중복: {found:?}");
+    found[0]
+}
+
+/// 단 구분선은 단 시작을 민 머리 띠(본문 폭 전체의 자리차지 개체) 아래의 단 영역에만
+/// 긋고, 마지막 본문 글줄 아래에서 멈춘다(문단 테두리의 줄 뒤 간격은 넣지 않는다).
+/// 기대값은 같은 파일의 맥용 한글 12.30 Print PDF 벡터 좌표(pdftocairo, 96dpi px)이다:
+/// header-table-boxes 248.00..1430.56, coanchored-stack 137.12..1037.76,
+/// empty-host-negative-offset 120.16..423.20. 수정 전 위끝은 본문 영역 맨 위
+/// (151.16 · 75.57 · 90.71)여서 머리 표를 세로로 가로질렀다. coanchored-stack 은 제목
+/// 상자만 본문 폭 전체이고 뒤 표·둥근 상자는 왼쪽 단 안이라, 구분선은 그 옆을 지난다.
+#[test]
+fn column_separator_starts_below_the_header_band() {
+    // (문서, 머리 개체(표인가, 문단, 컨트롤), Print 구분선 위끝, 아래끝)
+    let cases: [(&str, &[(bool, usize, usize)], f64, f64); 3] = [
+        ("header-table-boxes.hwpx", &[(true, 0, 5)], 248.00, 1430.56),
+        (
+            "coanchored-stack.hwpx",
+            &[(false, 0, 3), (true, 0, 4), (false, 0, 5), (true, 0, 6)],
+            137.12,
+            1037.76,
+        ),
+        ("empty-host-negative-offset.hwpx", &[(true, 0, 4)], 120.16, 423.20),
+    ];
+    for (name, headers, print_top, print_end) in cases {
+        let core = load(name);
+        let page = core.build_page_render_tree(0).unwrap();
+        let (x, top, end) = column_separator(&page.root);
+        for &(is_table, para, control) in headers {
+            let b = if is_table {
+                table(&page.root, para, control)
+            } else {
+                rectangle(&page.root, para, control)
+            };
+            // 구분선 x 를 가로로 걸친 머리 개체만 구분선과 만날 수 있다.
+            if b.x < x - EPS && b.x + b.width > x + EPS {
+                assert!(
+                    top >= bottom(&b) - EPS,
+                    "{name}: 구분선이 머리 개체 ({para}, {control}) 를 가로지른다: 위끝 {top:.2}, 개체 아래 {:.2}",
+                    bottom(&b)
+                );
+            }
+        }
+        assert!(
+            (top - print_top).abs() <= 1.0,
+            "{name}: 구분선 위끝이 Print 와 다르다: 실제 {top:.2}, Print {print_top:.2}"
+        );
+        assert!(
+            (end - print_end).abs() <= 1.0,
+            "{name}: 구분선 아래끝이 Print 와 다르다: 실제 {end:.2}, Print {print_end:.2}"
+        );
+        let lines = body_lines(&page.root);
+        for col in [0usize, 1] {
+            let first = lines
+                .iter()
+                .filter(|(c, p, _)| *c == col && *p >= 1)
+                .map(|(_, _, b)| b.y)
+                .fold(f64::INFINITY, f64::min);
+            assert!(
+                top <= first + EPS,
+                "{name}: 구분선이 단 {col} 첫 글줄보다 아래에서 시작한다: 위끝 {top:.2}, 글줄 {first:.2}"
+            );
+        }
+        let last = lines
+            .iter()
+            .map(|(_, _, b)| bottom(b))
+            .fold(f64::NEG_INFINITY, f64::max);
+        assert!(
+            end <= last + 1.0,
+            "{name}: 구분선이 마지막 글줄 아래로 더 내려간다: 아래끝 {end:.2}, 글줄 {last:.2}"
+        );
+    }
+}
+
 /// 저장 사다리가 음수 오프셋까지 닫은 빈 문단 머리 표는 본문 위로 올라가고, 뒤 문단은
 /// 그 표 아래에서 바로 이어진다.
 #[test]
