+//! 2단 시험지 머리 부분의 자리차지 개체 배치 계약.
+//!
+//! 입력은 학교 시험지 세 종의 글자·그림을 무의미한 내용으로 바꾼 공개 재현본이다.
+//! 개체 속성과 저장 줄 위치는 원본 그대로이며(음수 오프셋 재현본은 줄인 만큼 저장 줄
+//! 위치를 당겼다), 같은 파일의 한컴 인쇄 PDF와 저장 사다리로 기대 배치를 확인했다.
+//! 좌표 대신 겹침·순서·간격 관계를 검사한다.
+//!
+//! - `header-table-boxes`: 2단 첫 문단의 전폭 문단 기준 머리 표(#8158 형상)와 두 단의
+//!   글자처럼 취급 `<보기>` 표.
+//! - `coanchored-stack`: 같은 빈 문단에 종이 기준 제목 상자 · 표 · 둥근 상자 · 표가
+//!   차례로 앵커된 해설지 머리.
+//! - `empty-host-negative-offset`: 빈 문단의 음수 세로 오프셋 머리 표. 다음 문단의
+//!   저장 위치가 `오프셋 + 바깥 상자`로 정확히 닫힌다. 원본 1쪽 첫 문제와 2단 첫 부분만
+//!   남겼다(큰 표·미주 삭제).
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use rhwp::model::control::Control;
+use rhwp::renderer::render_tree::{BoundingBox, RenderNode, RenderNodeType};
+use rhwp::DocumentCore;
+
+const EPS: f64 = 0.5;
+
+fn load(name: &str) -> DocumentCore {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("samples/two_column_exam_floats")
+        .join(name);
+    let bytes = std::fs::read(&path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    DocumentCore::from_bytes(&bytes).expect("재현본 열기")
+}
+
+fn walk<'a>(node: &'a RenderNode, out: &mut Vec<&'a RenderNode>) {
+    out.push(node);
+    for child in &node.children {
+        walk(child, out);
+    }
+}
+
+fn bottom(b: &BoundingBox) -> f64 {
+    b.y + b.height
+}
+
+fn table(root: &RenderNode, para: usize, control: usize) -> BoundingBox {
+    let mut nodes = Vec::new();
+    walk(root, &mut nodes);
+    let found: Vec<_> = nodes
+        .iter()
+        .filter(|n| {
+            matches!(&n.node_type, RenderNodeType::Table(t)
+                if t.para_index == Some(para) && t.control_index == Some(control))
+        })
+        .collect();
+    assert_eq!(found.len(), 1, "표 ({para}, {control}) 누락·중복");
+    found[0].bbox
+}
+
+fn rectangle(root: &RenderNode, para: usize, control: usize) -> BoundingBox {
+    let mut nodes = Vec::new();
+    walk(root, &mut nodes);
+    let found: Vec<_> = nodes
+        .iter()
+        .filter(|n| {
+            matches!(&n.node_type, RenderNodeType::Rectangle(r)
+                if r.para_index == Some(para) && r.control_index == Some(control))
+        })
+        .collect();
+    assert_eq!(found.len(), 1, "도형 ({para}, {control}) 누락·중복");
+    found[0].bbox
+}
+
+/// 단(Column)에 직접 놓인 본문 글줄 — 표 셀 안 글줄은 제외한다.
+fn body_lines(root: &RenderNode) -> Vec<(usize, usize, BoundingBox)> {
+    let mut out = Vec::new();
+    let mut nodes = Vec::new();
+    walk(root, &mut nodes);
+    for column in nodes
+        .iter()
+        .filter(|n| matches!(n.node_type, RenderNodeType::Column(_)))
+    {
+        let RenderNodeType::Column(index) = column.node_type else {
+            continue;
+        };
+        for child in &column.children {
+            if let RenderNodeType::TextLine(line) = &child.node_type {
+                if let Some(para) = line.para_index {
+                    out.push((index as usize, para, child.bbox));
+                }
+            }
+        }
+    }
+    out
+}
+
+fn column_bbox(root: &RenderNode, index: u16) -> BoundingBox {
+    let mut nodes = Vec::new();
+    walk(root, &mut nodes);
+    nodes
+        .iter()
+        .find(|n| matches!(n.node_type, RenderNodeType::Column(i) if i == index))
+        .map(|n| n.bbox)
+        .expect("단")
+}
+
+/// #8158 형상: 앵커 단의 본문은 머리 표 바로 아래에서 시작하고, 표 높이만큼 다시 밀리지
+/// 않는다. 다른 단도 머리 표 아래에서 시작한다.
+#[test]
+fn body_wide_para_header_is_not_pushed_twice_in_its_anchor_column() {
+    let core = load("header-table-boxes.hwpx");
+    let page = core.build_page_render_tree(0).unwrap();
+    let header = table(&page.root, 0, 5);
+    let column = column_bbox(&page.root, 0);
+    assert!(
+        header.y < column.y + header.height / 2.0,
+        "머리 표가 앵커 문단 자리에 놓인다: 표 {:.1}, 단 {:.1}",
+        header.y,
+        column.y
+    );
+    let lines = body_lines(&page.root);
+    let mut firsts = Vec::new();
+    for col in [0usize, 1] {
+        let first = lines
+            .iter()
+            .filter(|(c, _, _)| *c == col)
+            .map(|(_, _, b)| b.y)
+            .fold(f64::INFINITY, f64::min);
+        assert!(
+            first >= bottom(&header) - EPS,
+            "단 {col} 첫 글줄이 머리 표와 겹친다: 글줄 {first:.1}, 표 아래 {:.1}",
+            bottom(&header)
+        );
+        assert!(
+            first - bottom(&header) < header.height / 2.0,
+            "단 {col} 본문이 머리 표 높이만큼 다시 밀렸다: 글줄 {first:.1}, 표 아래 {:.1}",
+            bottom(&header)
+        );
+        firsts.push(first);
+    }
+    // 두 단은 같은 머리 표 아래에서 시작한다. 다른 단의 예약도 표의 바깥 위 여백을 포함한다.
+    assert!(
+        (firsts[0] - firsts[1]).abs() < EPS,
+        "두 단의 첫 글줄 높이가 다르다: 단 0 {:.1}, 단 1 {:.1}",
+        firsts[0],
+        firsts[1]
+    );
+}
+
+/// 다단에서 글자처럼 취급 표는 앞 문제 글줄 아래에 놓이고, 뒤 글줄과는 저장 줄 위치가
+/// 정한 간격(다음 문단 vpos − 표 문단 vpos − 표 높이)을 둔다.
+#[test]
+fn two_column_inline_boxes_stay_below_their_question_lines() {
+    let core = load("header-table-boxes.hwpx");
+    let page = core.build_page_render_tree(0).unwrap();
+    let lines = body_lines(&page.root);
+    let paragraphs = &core.document().sections[0].paragraphs;
+    let line_top = |para: usize| {
+        lines
+            .iter()
+            .filter(|(_, p, _)| *p == para)
+            .map(|(_, _, b)| b.y)
+            .fold(f64::INFINITY, f64::min)
+    };
+    for (para, question) in [(13usize, 12usize), (60, 59)] {
+        let boxed = table(&page.root, para, 0);
+        let question_bottom = lines
+            .iter()
+            .filter(|(_, p, _)| *p == question)
+            .map(|(_, _, b)| bottom(b))
+            .fold(f64::NEG_INFINITY, f64::max);
+        assert!(question_bottom.is_finite(), "문제 글줄 {question} 누락");
+        assert!(
+            boxed.y >= question_bottom - EPS,
+            "<보기> 표 {para} 가 문제 글줄 {question} 과 겹친다: 표 {:.1}, 글줄 아래 {question_bottom:.1}",
+            boxed.y
+        );
+
+        let next = line_top(para + 1);
+        assert!(next.is_finite(), "<보기> 뒤 글줄 {} 누락", para + 1);
+        let Control::Table(t) = &paragraphs[para].controls[0] else {
+            panic!("문단 {para} 첫 컨트롤이 표가 아니다");
+        };
+        let stored_gap_hu = paragraphs[para + 1].line_segs[0].vertical_pos
+            - paragraphs[para].line_segs[0].vertical_pos
+            - t.common.height as i32;
+        let stored_gap = f64::from(stored_gap_hu) / 75.0;
+        let gap = next - bottom(&boxed);
+        assert!(
+            (gap - stored_gap).abs() < 1.0,
+            "<보기> 표 {para} 뒤 간격이 저장 줄 위치와 다르다: 실제 {gap:.1}, 저장 {stored_gap:.1}"
+        );
+    }
+}
+
+/// 같은 빈 문단의 자리차지 개체는 종이 기준 제목 상자 아래에서 컨트롤 순서대로 쌓인다.
+#[test]
+fn coanchored_topbottom_objects_stack_in_control_order() {
+    let core = load("coanchored-stack.hwpx");
+    let page = core.build_page_render_tree(0).unwrap();
+    let title = rectangle(&page.root, 0, 3);
+    let first = table(&page.root, 0, 4);
+    let middle = rectangle(&page.root, 0, 5);
+    let last = table(&page.root, 0, 6);
+    let order = [
+        ("제목 상자", title),
+        ("첫 표", first),
+        ("둥근 상자", middle),
+        ("둘째 표", last),
+    ];
+    for pair in order.windows(2) {
+        let (upper_name, upper) = pair[0];
+        let (lower_name, lower) = pair[1];
+        assert!(
+            lower.y >= bottom(&upper) - EPS,
+            "{lower_name}({:.1}) 이 {upper_name} 아래({:.1})에 놓이지 않았다",
+            lower.y,
+            bottom(&upper)
+        );
+    }
+    let lines = body_lines(&page.root);
+    let after = lines
+        .iter()
+        .filter(|(c, p, _)| *c == 0 && *p >= 1)
+        .map(|(_, _, b)| b.y)
+        .fold(f64::INFINITY, f64::min);
+    assert!(
+        after >= bottom(&last) - EPS,
+        "뒤 본문이 쌓인 개체 위로 올라왔다: 글줄 {after:.1}, 둘째 표 아래 {:.1}",
+        bottom(&last)
+    );
+
+    // 개체를 쌓은 빈 문단은 자기 줄(저장 줄 높이 + 줄간격)을 개체 아래에 둔다. 다음 문단의
+    // 글자처럼 취급 둥근 상자는 그 줄 뒤에서 자기 바깥 위 여백만큼 내려간다.
+    let paragraphs = &core.document().sections[0].paragraphs;
+    let host_line = &paragraphs[0].line_segs[0];
+    let host_advance = f64::from(host_line.line_height + host_line.line_spacing) / 75.0;
+    let Control::Table(last_table) = &paragraphs[0].controls[6] else {
+        panic!("문단 0 컨트롤 6 이 표가 아니다");
+    };
+    let Control::Shape(boxed) = &paragraphs[1].controls[2] else {
+        panic!("문단 1 컨트롤 2 가 도형이 아니다");
+    };
+    let expected = bottom(&last)
+        + f64::from(last_table.outer_margin_bottom) / 75.0
+        + host_advance
+        + f64::from(boxed.common().margin.top) / 75.0;
+    let round = rectangle(&page.root, 1, 2);
+    assert!(
+        (round.y - expected).abs() < 1.0,
+        "빈 문단 줄 뒤의 둥근 상자 위치가 다르다: 실제 {:.1}, 기대 {expected:.1}",
+        round.y
+    );
+}
+
+/// 저장 사다리가 음수 오프셋까지 닫은 빈 문단 머리 표는 본문 위로 올라가고, 뒤 문단은
+/// 그 표 아래에서 바로 이어진다.
+#[test]
+fn witnessed_negative_offset_header_rises_and_flow_follows_it() {
+    let core = load("empty-host-negative-offset.hwpx");
+    let page = core.build_page_render_tree(0).unwrap();
+    let header = table(&page.root, 0, 4);
+    let column = column_bbox(&page.root, 0);
+    assert!(
+        header.y < column.y - EPS,
+        "음수 오프셋이 본문 맨 위에서 잘렸다: 표 {:.1}, 단 {:.1}",
+        header.y,
+        column.y
+    );
+    let lines = body_lines(&page.root);
+    for col in [0usize, 1] {
+        let first = lines
+            .iter()
+            .filter(|(c, p, _)| *c == col && *p >= 1)
+            .map(|(_, _, b)| b.y)
+            .fold(f64::INFINITY, f64::min);
+        assert!(
+            first >= bottom(&header) - EPS,
+            "단 {col} 글줄이 머리 표와 겹친다: 글줄 {first:.1}, 표 아래 {:.1}",
+            bottom(&header)
+        );
+        assert!(
+            first - bottom(&header) < header.height / 2.0,
+            "단 {col} 본문이 머리 표 아래로 떨어져 있다: 글줄 {first:.1}, 표 아래 {:.1}",
+            bottom(&header)
+        );
+    }
+}
