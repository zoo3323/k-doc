index 000000000..0820e0e34
--- /dev/null
+++ b/rhwp-studio/src/engine/cell-equation.ts
@@ -0,0 +1,34 @@
+import type { WasmBridge } from '@/core/wasm-bridge';
+
+/** 수식 개체 주소. 셀 안 수식은 `ci` 가 바깥 표, `innerControlIdx` 가 셀 문단 안 인덱스다. */
+export interface EquationRef {
+  sec: number;
+  ppi: number;
+  ci: number;
+  cellIdx?: number;
+  cellParaIdx?: number;
+  innerControlIdx?: number;
+}
+
+/** 셀 문단 안 인덱스까지 아는 깊이 1 표 셀 수식인가. */
+export function isAddressedCellEquation(ref: EquationRef): ref is EquationRef & {
+  cellIdx: number;
+  cellParaIdx: number;
+  innerControlIdx: number;
+} {
+  return ref.cellIdx !== undefined && ref.cellParaIdx !== undefined && ref.innerControlIdx !== undefined;
+}
+
+/** 수식을 지운다. 셀 안 수식은 셀 경로로, 본문 수식은 예전처럼. */
+export function deleteEquationRef(wasm: WasmBridge, ref: EquationRef): void {
+  if (isAddressedCellEquation(ref)) {
+    wasm.deleteCellEquationControlByPath(
+      ref.sec,
+      ref.ppi,
+      [{ controlIndex: ref.ci, cellIndex: ref.cellIdx, cellParaIndex: ref.cellParaIdx }],
+      ref.innerControlIdx,
+    );
+    return;
+  }
+  wasm.deleteEquationControl(ref.sec, ref.ppi, ref.ci);
+}
