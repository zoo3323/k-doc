+/// `--cell-path` JSON(`[{"controlIndex":N,"cellIndex":N,"cellParaIndex":N}, ...]`)을 읽는다.
+fn parse_cell_path(raw: &str) -> Result<Vec<(usize, usize, usize)>, String> {
+    let value: serde_json::Value =
+        serde_json::from_str(raw).map_err(|e| format!("JSON 이 아닙니다: {e}"))?;
+    let entries = value.as_array().ok_or("JSON 배열이어야 합니다.")?;
+    entries
+        .iter()
+        .map(|entry| {
+            let field = |name: &str| {
+                entry
+                    .get(name)
+                    .and_then(serde_json::Value::as_u64)
+                    .map(|n| n as usize)
+                    .ok_or_else(|| format!("각 항목에 0 이상의 정수 {name} 가 필요합니다."))
+            };
+            Ok((field("controlIndex")?, field("cellIndex")?, field("cellParaIndex")?))
+        })
+        .collect()
+}
