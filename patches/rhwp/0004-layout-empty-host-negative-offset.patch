         .zip(next_para.and_then(stored_vpos))
         .is_some_and(|(current, next)| next - current == occupied_height);
     stored_outer_box.then_some(occupied_height)
 }
 
+/// 저장 사다리가 바깥 상자와 함께 소비한 세로 오프셋(HU). 인라인 줄 뒤 양수 오프셋과
+/// 저장 사다리로 닫힌 빈 host 의 음수 오프셋만 해당하고, 그 밖은 0이다.
+fn stored_ladder_offset_hu(para: &Paragraph, next_para: Option<&Paragraph>, table: &Table) -> i64 {
+    if offset_float_follows_inline_line(para, table) {
+        i64::from(table.common.vertical_offset)
+    } else {
+        stored_negative_offset_hu(para, next_para, table).unwrap_or(0)
+    }
+}
