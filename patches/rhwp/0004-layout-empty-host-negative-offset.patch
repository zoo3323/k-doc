+/// 글자 없는 host 의 음수 세로 오프셋 자리차지 표가 저장 사다리로 인증한 오프셋(HU).
+///
+/// 문단 기준 표의 음수 오프셋은 표를 앵커 위로 올린다. 빈 host 경로는 근거가 없어 이를
+/// 앵커에서 잘라 왔지만, 다음 문단의 저장 `vpos` 가 `host + 오프셋 + 위여백 + 높이 +
+/// 아래여백` 과 정확히 같으면 한/글이 오프셋을 그대로 소비했다는 증거다(2단 시험지 머리
+/// 표: host 0 · 오프셋 −5376 · 283 + 6447 + 850 → 다음 문단 2204). 이때만 오프셋을 돌려준다.
+/// 조판(lane)과 렌더(lane)가 같은 판정을 쓴다.
+pub(crate) fn stored_negative_offset_hu(
+    para: &Paragraph,
+    next_para: Option<&Paragraph>,
+    table: &Table,
+) -> Option<i64> {
+    use crate::model::shape::VertAlign;
+    let offset = i64::from(crate::renderer::float_placement::signed_hwpunit(
+        table.common.vertical_offset,
+    ));
+    if offset >= 0
+        || table.common.treat_as_char
+        || table.common.allow_overlap
+        || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+        || !matches!(table.common.vert_align, VertAlign::Top | VertAlign::Inside)
+        || table.common.height == 0
+        || table.common.height > i32::MAX as u32
+        || para.stored_text_partition_is_dirty()
+        || para
+            .text
+            .chars()
+            .any(|ch| !ch.is_whitespace() && !ch.is_control() && ch != '\u{fffc}')
+    {
+        return None;
+    }
+    let next = next_para?;
+    if next.stored_text_partition_is_dirty() {
+        return None;
+    }
+    let host = stored_vpos(para)?;
+    let successor = stored_vpos(next)?;
+    let outer_box = offset
+        + i64::from(table.outer_margin_top)
+        + i64::from(table.common.height)
+        + i64::from(table.outer_margin_bottom);
+    (outer_box > 0 && successor - host == outer_box).then_some(offset)
+}
